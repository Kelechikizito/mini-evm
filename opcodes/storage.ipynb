   "source": [
    "def sload(evm):\n",
    "    key = evm.stack.pop().value\n",
    "    warm, value = evm.storage.load(key)\n",
    "    evm.stack.push(value)\n",
    "\n",
    "    evm.gas_dec(2100)  # 100 if warm\n",
    "    evm.pc += 1"
   ]
  }
